{
  "name": "@apaar-platform/integration-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "reference:migrate": "tsx src/migrate-reference.ts",
    "reference:reset": "tsx src/reset-reference.ts",
    "reference:seed": "tsx src/seed-reference.ts",
    "reference:worker": "tsx src/worker.ts",
    "start:portal": "node dist/portal-server.js",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:pilot": "vitest run --config vitest.pilot.config.ts",
    "test:execution": "vitest run --config vitest.execution.config.ts",
    "typecheck": "tsc -p tsconfig.lint.json --noEmit"
  },
  "dependencies": {
    "@apaar-platform/admission-application": "0.1.0",
    "@apaar-platform/admission-casework": "0.1.0",
    "@apaar-platform/admission-domain": "0.1.0",
    "@apaar-platform/batch-ingestion": "0.1.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1"
  }
}
