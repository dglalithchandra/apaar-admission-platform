{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/student-admission.schema.json",
  "title": "Student admission command",
  "description": "Product-owned command contract. Provider-specific academic-identity fields are intentionally excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKey",
    "studentReference",
    "institutionId",
    "campusId",
    "programmeId",
    "courseId",
    "academicYear",
    "admissionDate",
    "category",
    "lateralCapacitySource",
    "studentStatus",
    "eligibilityEvidence",
    "identityVerification"
  ],
  "properties": {
    "recordKey": { "type": "string", "minLength": 8, "maxLength": 128 },
    "studentReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Opaque product reference; never an APAAR database primary key."
    },
    "institutionId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "campusId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "programmeId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "courseId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "academicYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "admissionDate": { "type": "string", "format": "date" },
    "category": {
      "type": "string",
      "enum": [
        "ORDINARY",
        "NRI",
        "FOREIGN_NATIONAL",
        "OCI",
        "GULF_WORKER_CHILD",
        "LATERAL_ENTRY",
        "TFW",
        "PM_USPY",
        "OTHER_SUPERNUMERARY"
      ]
    },
    "lateralCapacitySource": {
      "type": ["string", "null"],
      "enum": [null, "LATERAL_SUPERNUMERARY", "LATERAL_FIRST_YEAR_VACANCY"]
    },
    "studentStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nri", "oci", "foreignNational", "gulfWorkerChild"],
      "properties": {
        "nri": { "type": "boolean" },
        "oci": { "type": "boolean" },
        "foreignNational": { "type": "boolean" },
        "gulfWorkerChild": { "type": "boolean" }
      }
    },
    "eligibilityEvidence": { "type": "string", "enum": ["VERIFIED", "PENDING", "MISSING"] },
    "identityVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checkedAt", "providerContractVersion", "providerRequestReference"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "NOT_FOUND",
            "MISMATCH",
            "TEMPORARILY_UNAVAILABLE",
            "RATE_LIMITED",
            "NOT_ELIGIBLE_FOR_APAAR",
            "MANUAL_REVIEW",
            "UNVERIFIED"
          ]
        },
        "checkedAt": { "type": "string", "format": "date-time" },
        "providerContractVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "providerRequestReference": { "type": ["string", "null"], "maxLength": 128 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "category": { "const": "LATERAL_ENTRY" } },
        "required": ["category"]
      },
      "then": { "properties": { "lateralCapacitySource": { "type": "string" } } },
      "else": { "properties": { "lateralCapacitySource": { "type": "null" } } }
    }
  ]
}
