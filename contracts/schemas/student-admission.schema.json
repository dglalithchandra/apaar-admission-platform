{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/student-admission.schema.json",
  "title": "Student admission command",
  "description": "Draft product-owned schema. All example identifiers are synthetic.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordKey",
    "institutionId",
    "campusId",
    "programmeId",
    "academicYear",
    "institutionStudentId",
    "studentName",
    "dateOfBirth",
    "admissionDate",
    "seatBucket"
  ],
  "properties": {
    "recordKey": { "type": "string", "minLength": 8, "maxLength": 128 },
    "institutionId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "campusId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "programmeId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "academicYear": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "apaarId": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
    "identityExceptionReason": {
      "type": ["string", "null"],
      "enum": [null, "NOT_ELIGIBLE_FOR_APAAR", "PENDING_ISSUANCE", "TEMPORARILY_UNAVAILABLE", "OTHER_REVIEW_REQUIRED"]
    },
    "institutionStudentId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "studentName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "dateOfBirth": { "type": "string", "format": "date" },
    "admissionDate": { "type": "string", "format": "date" },
    "seatBucket": {
      "type": "string",
      "enum": ["REGULAR", "SUPERNUMERARY", "NRI", "OCI", "FOREIGN_NATIONAL", "OTHER_POLICY_BUCKET"]
    },
    "nri": { "type": "boolean", "default": false },
    "oci": { "type": "boolean", "default": false },
    "foreignNational": { "type": "boolean", "default": false },
    "consentReference": { "type": ["string", "null"], "maxLength": 128 }
  },
  "allOf": [
    {
      "if": { "properties": { "apaarId": { "type": "null" } }, "required": ["apaarId"] },
      "then": { "required": ["identityExceptionReason"] }
    }
  ]
}
