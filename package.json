{
  "name": "apaar-admission-platform",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build -w @apaar-platform/admission-domain && npm run build -w @apaar-platform/admission-application && npm run build -w @apaar-platform/batch-ingestion && npm run build -w @apaar-platform/admission-casework && npm run build -w @apaar-platform/integration-gateway && npm run build -w @apaar-platform/institution-portal",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run validate:contracts && npm run build",
    "clean": "npm run clean --workspaces --if-present",
    "format": "prettier --write \"services/**/*.{ts,json,md}\" \"apps/**/*.{ts,tsx,json,md,css,html}\" \"contracts/**/*.{json,yaml}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,ts,json}\" \"infra/**/*.{yaml,yml,md}\" \"*.{json,mjs}\" \"docs/**/*.md\" \"README.md\"",
    "format:check": "prettier --check \"services/**/*.{ts,json,md}\" \"apps/**/*.{ts,tsx,json,md,css,html}\" \"contracts/**/*.{json,yaml}\" \"scripts/**/*.{js,mjs,ts}\" \"tests/**/*.{js,ts,json}\" \"infra/**/*.{yaml,yml,md}\" \"*.{json,mjs}\" \"docs/**/*.md\" \"README.md\"",
    "lint": "eslint .",
    "load:smoke": "docker run --rm -i --add-host=host.docker.internal:host-gateway -e BASE_URL=http://host.docker.internal:8080 grafana/k6:1.3.0@sha256:3ddc8b1a33a2c3d8edc6e99b6a762ae36cba08788463458f5e6a7703e14eb77d run - < tests/load/smoke.js",
    "security:licenses": "node scripts/license-inventory.mjs",
    "security:sbom": "npm sbom --sbom-format cyclonedx",
    "security:scan": "node scripts/security-scan.mjs",
    "test:container": "node scripts/container-smoke.mjs",
    "test:recovery": "node scripts/recovery-smoke.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:e2e:batch": "npm run test:integration -w @apaar-platform/batch-ingestion",
    "test:e2e:casework": "npm run test:integration -w @apaar-platform/admission-casework",
    "test:e2e:gateway": "npm run test:integration -w @apaar-platform/integration-gateway",
    "test:e2e:pilot": "npm run test:pilot -w @apaar-platform/integration-gateway",
    "test:integration:postgres": "npm run test:integration -w @apaar-platform/admission-application",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:contracts": "redocly lint contracts/openapi/apaar-platform.yaml && tsx scripts/validate-json-schema.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@redocly/cli": "2.71.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
